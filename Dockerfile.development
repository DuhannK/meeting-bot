FROM node:20

WORKDIR /usr/src/app

# Install system dependencies, including WebGL support and audio
RUN apt-get update && \
  apt-get install -y \
  ffmpeg \
  libnss3 \
  libxss1 \
  libasound2 \
  pulseaudio \
  alsa-utils \
  libatk1.0-0 \
  libatk-bridge2.0-0 \
  libcups2 \
  libxkbcommon-x11-0 \
  libgbm-dev \
  libgl1-mesa-dri \
  libgl1-mesa-glx \
  mesa-utils \
  xvfb \
  wget \
  gnupg \
  xorg \
  xserver-xorg \
  libx11-dev \
  libxext-dev \
  # ARM-specific packages (only for ARM64)
  $(if [ "$(dpkg --print-architecture)" = "arm64" ]; then echo "libgles2 libegl1 libwayland-egl1"; fi) \
  && rm -rf /var/lib/apt/lists/*

# Install Google Chrome
RUN wget -q -O - https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /usr/share/keyrings/google-linux-signing-key.gpg && \
  ARCH=$(dpkg --print-architecture) && \
  if [ "$ARCH" = "amd64" ]; then \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-linux-signing-key.gpg] http://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list; \
  elif [ "$ARCH" = "arm64" ]; then \
    echo "deb [arch=arm64 signed-by=/usr/share/keyrings/google-linux-signing-key.gpg] http://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list; \
  else \
    echo "deb [signed-by=/usr/share/keyrings/google-linux-signing-key.gpg] http://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list; \
  fi && \
  apt-get update && apt-get install -y google-chrome-stable || apt-get install -y chromium && \
  rm -rf /var/lib/apt/lists/*

# Create symlink for Playwright compatibility (ARM64 only)
RUN if [ "$(dpkg --print-architecture)" = "arm64" ]; then ln -sf /usr/bin/chromium /usr/bin/google-chrome; fi

# Non-root user (uid 1001, matches Dockerfile.production): PulseAudio refuses to
# start as root ("This program is not intended to be run as root"), which broke
# Teams recording (ffmpeg's pulse audio input had no daemon to connect to).
RUN groupadd -g 1001 nodejs && \
    useradd -m -d /home/nodejs -r -u 1001 -g nodejs nodejs

# Copy Chrome policy to allow protocol launching
RUN mkdir -p /etc/opt/chrome/policies/managed
COPY --chown=nodejs:nodejs auto_launch_protocols.json /etc/opt/chrome/policies/managed/auto_launch_protocols.json

# Install global tools
RUN npm install -g nodemon

# Install dependencies
COPY package*.json ./
RUN npm install

# Install Playwright and its dependencies
RUN npx playwright install --with-deps

# Copy application code
COPY . .

# Build app
RUN npm run build

# Set permissions
RUN chmod +x /usr/src/app/start.sh

# X11 socket dir: created here for parity with production, but the real one at
# runtime lives under the bind-mounted /usr/src/app tree from docker-compose,
# so this mainly matters for non-compose `docker run` usage.
RUN mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

RUN mkdir -p /usr/src/app/dist/_tempvideo \
    && chmod -R 777 /usr/src/app/dist/_tempvideo

# PulseAudio needs its runtime + config dirs owned by the user that will run it
RUN mkdir -p /run/user/1001 \
    && chown -R nodejs:nodejs /run/user/1001 \
    && chmod 700 /run/user/1001
RUN mkdir -p /home/nodejs/.config/pulse \
    && chown -R nodejs:nodejs /home/nodejs/.config

# node_modules is preserved via an anonymous volume (docker-compose.yml) across
# rebuilds; make sure the non-root user can still write into it (npm installs,
# nodemon, etc.) instead of just read what this build produced.
RUN chown -R nodejs:nodejs /usr/src/app/node_modules

USER nodejs

# Playwright's own helper binaries (e.g. the bundled ffmpeg used by recordVideo
# in dev mode) were fetched as root above, into /root/.cache — the wrong home
# dir now that the app runs as nodejs. Re-run as nodejs so its cache is populated
# under /home/nodejs/.cache/ms-playwright too (matches Dockerfile.production).
RUN npx playwright install

EXPOSE 3000

CMD ["node", "dist/index.js"]
